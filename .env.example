# Pick one provider. Claude is used if both are set (override with AI_PROVIDER=claude|groq).
ANTHROPIC_API_KEY=
# Optional per-job model overrides (defaults shown)
# ANTHROPIC_MODEL_EXTRACT=claude-haiku-5-5    # reading the ballot file
# ANTHROPIC_MODEL_RESEARCH=claude-haiku-5-5   # web search + note taking
# ANTHROPIC_MODEL_ANALYZE=claude-sonnet-5-5   # candidate cards and red-flag calls
# ANTHROPIC_MODEL_ANALYZE_MEASURE=claude-opus-5-5  # ballot measure analysis

GROQ_API_KEY=
# Optional Groq model overrides
# GROQ_RESEARCH_MODEL=groq/compound
# GROQ_STRUCT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Development: serve fixture data instead of calling an AI provider
# MOCK_AI=1

# Optional: 30-day shared research cache (set automatically when a Vercel Blob store is connected)
# BLOB_READ_WRITE_TOKEN=

# Optional: look up a sample ballot by address (Google Civic Information API key)
# GOOGLE_CIVIC_API_KEY=

# Optional "chip in" links shown after export (e.g. Stripe Payment Links). Set at build time.
# NEXT_PUBLIC_SUPPORT_URL=      # "customer chooses what to pay" link, suggested $5
# NEXT_PUBLIC_SUPPORT_URL_3=    # optional fixed-amount links for one-tap buttons
# NEXT_PUBLIC_SUPPORT_URL_5=
# NEXT_PUBLIC_SUPPORT_URL_10=
# NEXT_PUBLIC_SUPPORT_URL_20=

# Abuse protection. Counters use Upstash Redis when connected (Vercel Marketplace sets
# KV_REST_API_URL / KV_REST_API_TOKEN); otherwise each server instance counts in memory.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# DAILY_BUDGET_USD=100          # pause new research once today's AI spend reaches this (0 = no cap)
# RATE_LIMIT_SALT=              # random string used to hash IPs/device IDs

# Shown on the Terms and Privacy pages
# NEXT_PUBLIC_CONTACT_EMAIL=
