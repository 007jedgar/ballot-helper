# Pick one provider. Claude is used if both are set (override with AI_PROVIDER=claude|groq).
ANTHROPIC_API_KEY=
# Optional per-job model overrides (defaults shown)
# ANTHROPIC_MODEL_EXTRACT=claude-haiku-5-5    # reading the ballot file
# ANTHROPIC_MODEL_RESEARCH=claude-haiku-5-5   # web search + note taking
# ANTHROPIC_MODEL_ANALYZE=claude-opus-5-5     # candidate cards, red flags, measure analysis

GROQ_API_KEY=
# Optional Groq model overrides
# GROQ_RESEARCH_MODEL=groq/compound
# GROQ_STRUCT_MODEL=openai/gpt-oss-120b
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Development: serve fixture data instead of calling an AI provider
# MOCK_AI=1

# Optional: 30-day shared research cache (set automatically when a Vercel Blob store is connected)
# BLOB_READ_WRITE_TOKEN=
